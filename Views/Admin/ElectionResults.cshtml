@using VotingSystem.Services
@{
    ViewData["Title"] = "Election Results";
    var election = ViewBag.Election as Election;
    var positions = ViewBag.Positions as List<Position>;
    var results = ViewBag.Results as Dictionary<string, List<ElectionService.CandidateResult>>;
    var totalVoters = ViewBag.TotalVoters as int?;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2>Election Results</h2>
            <h4>@election?.Title</h4>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Total Voters:</strong> @totalVoters</p>
                    <p><strong>Election Period:</strong> @election?.StartAt.ToLocalTime().ToString("MMM dd, yyyy") - @election?.EndAt.ToLocalTime().ToString("MMM dd, yyyy")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Status:</strong> <span class="badge badge-past">@election?.ComputedStatus</span></p>
                </div>
            </div>
        </div>
    </div>

    @if (positions != null && positions.Any())
    {
        @foreach (var position in positions)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5>@position.Title</h5>
                </div>
                <div class="card-body">
                    @if (results != null && results.ContainsKey(position.Id!))
                    {
                        var positionResults = results[position.Id!];
                        var totalVotesForPosition = positionResults.Sum(r => r.VoteCount);

                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Candidate Name</th>
                                        <th>Student Number</th>
                                        <th>Votes</th>
                                        <th>Percentage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int rank = 1;
                                    }
                                    @foreach (var result in positionResults)
                                    {
                                        var percentage = totalVotesForPosition > 0 ? (result.VoteCount * 100.0 / totalVotesForPosition) : 0;
                                        <tr class="@(rank == 1 && result.VoteCount > 0 ? "table-success" : "")">
                                            <td>
                                                @if (rank == 1 && result.VoteCount > 0)
                                                {
                                                    <strong>🏆 @rank</strong>
                                                }
                                                else
                                                {
                                                    @rank
                                                }
                                            </td>
                                            <td><strong>@result.CandidateName</strong></td>
                                            <td>@result.StudentNumber</td>
                                            <td><strong>@result.VoteCount</strong></td>
                                            <td>@percentage.ToString("F2")%</td>
                                        </tr>
                                        rank++;
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (totalVotesForPosition > 0)
                        {
                            <div class="alert alert-info mt-3">
                                <strong>Winner:</strong> @positionResults.FirstOrDefault()?.CandidateName with @positionResults.FirstOrDefault()?.VoteCount vote(s)
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No votes recorded for this position.</p>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">No positions found for this election.</div>
    }
</div>
