@model List<Candidate>
@{
    ViewData["Title"] = "Candidate Approvals";
}

<div class="container mt-4">
    <h2 class="mb-4">Candidate Approvals</h2>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Student Number</th>
                        <th>Election ID</th>
                        <th>Position ID</th>
                        <th>Bio</th>
                        <th>Applied At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var candidate in Model)
                    {
                        <tr>
                            <td>@candidate.Name</td>
                            <td>@candidate.StudentNumber</td>
                            <td>@candidate.ElectionId</td>
                            <td>@candidate.PositionId</td>
                            <td>@(candidate.Bio.Length > 50 ? candidate.Bio.Substring(0, 50) + "..." : candidate.Bio)</td>
                            <td>@candidate.AppliedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td>
                                <form asp-action="ApproveCandidate" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@candidate.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                </form>
                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal_@candidate.Id">
                                    Reject
                                </button>

                                <!-- Reject Modal -->
                                <div class="modal fade" id="rejectModal_@candidate.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Reject Candidate</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="RejectCandidate" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-body">
                                                    <input type="hidden" name="id" value="@candidate.Id" />
                                                    <div class="mb-3">
                                                        <label class="form-label">Reason for rejection</label>
                                                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger">Reject</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <p class="text-muted">No pending candidate applications.</p>
        </div>
    }
</div>
