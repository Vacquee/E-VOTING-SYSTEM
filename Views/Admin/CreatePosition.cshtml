@model Position
@{
    ViewData["Title"] = "Create Position";
    var election = ViewBag.Election as Election;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">Create Position for @election?.Title</h2>

            <div class="card">
                <div class="card-body">
                    <form asp-action="CreatePosition" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ElectionId" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Position Title</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., President, Vice President" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Order" class="form-label">Display Order</label>
                            <input asp-for="Order" type="number" class="form-control" value="0" />
                            <span asp-validation-for="Order" class="text-danger"></span>
                            <small class="text-muted">Lower numbers appear first.</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Create Position</button>
                            <a asp-action="ElectionDetails" asp-route-id="@election?.Id" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
