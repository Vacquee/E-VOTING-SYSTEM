@model CandidateApplicationViewModel
@{
    ViewData["Title"] = "Apply as Candidate";
    var election = ViewBag.Election as Election;
    var position = ViewBag.Position as Position;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">Apply as Candidate</h2>

            <div class="card mb-4">
                <div class="card-body">
                    <h5>@election?.Title</h5>
                    <p class="mb-1"><strong>Position:</strong> @position?.Title</p>
                    @if (!string.IsNullOrEmpty(position?.Description))
                    {
                        <p class="text-muted">@position.Description</p>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Candidate Application Form</h5>
                </div>
                <div class="card-body">
                    <form asp-action="ApplyCandidate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ElectionId" />
                        <input type="hidden" asp-for="PositionId" />

                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label">Biography / Platform Statement</label>
                            <textarea asp-for="Bio" class="form-control" rows="6"
                                      placeholder="Tell voters about yourself and why you're running for this position (50-500 characters)"></textarea>
                            <span asp-validation-for="Bio" class="text-danger"></span>
                            <small class="text-muted">Minimum 50 characters, maximum 500 characters.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhotoUrl" class="form-label">Photo URL (Optional)</label>
                            <input asp-for="PhotoUrl" class="form-control" placeholder="https://example.com/photo.jpg" />
                            <span asp-validation-for="PhotoUrl" class="text-danger"></span>
                            <small class="text-muted">In a real application, you would upload a photo.</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Submit Application</button>
                            <a asp-action="Election" asp-route-id="@election?.Id" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
